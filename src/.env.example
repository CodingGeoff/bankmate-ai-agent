# 仅示例。先阅读 README；环境变量需要在运行应用前设置。
# 不应提交真实密钥，不要输入真实银行或个人数据。
BANKMATE_TOOL_AGENT=1
# 按优先级指定显式允许的提供商（最多5个）；不填写不会发送到这些提供商。
BANKMATE_PROVIDERS=siliconflow,groq,ovh
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
# 显式启用 OVH 匿名第三方服务：内容会发送给该提供商
BANKMATE_ALLOW_ANONYMOUS=0
OVH_MODEL=gpt-oss-20b
OVH_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
